<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>neo3ds converter</AssemblyTitle>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Compression needs a self-contained publish (package_release.ps1 -FrameworkDependent skips it) -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Everything the converter needs at runtime is copied next to the exe under tools\ -->
  <ItemGroup>
    <None Include="..\assets\neo3ds.rsf" Link="tools\neo3ds.rsf" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\engine\engine.elf" Link="tools\engine.elf" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\tools\makerom\makerom.exe" Link="tools\makerom.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\tools\bannertool\windows-x86_64\bannertool.exe" Link="tools\bannertool.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- Checked by CheckRuntimePayload (converter/Directory.Build.targets) before MSB3030 can fire -->
  <ItemGroup>
    <RequiredTool Include="..\..\tools\makerom\makerom.exe" Display="tools/makerom/makerom.exe" Help="Get it from a release zip or upstream (see docs/build.md 2)." />
    <RequiredTool Include="..\..\tools\bannertool\windows-x86_64\bannertool.exe" Display="tools/bannertool/windows-x86_64/bannertool.exe" Help="Get it from a release zip or upstream (see docs/build.md 2)." />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Neo3dsConverter.Core/Neo3dsConverter.Core.csproj" />
  </ItemGroup>

</Project>
